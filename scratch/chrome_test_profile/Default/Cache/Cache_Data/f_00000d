const __vite__css = "/* ==========================================================================\n   ARISS Island Series — Interactive Architectural Showroom Styling\n   Composition: Procedural Luxury Living Room on Left, Custom Keypad on Right\n   ========================================================================== */\n\n.showroom-app {\n  min-height: 100vh;\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  background-color: #000000;\n  color: #f1f5f9;\n  font-family: 'Inter', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;\n  overflow-x: hidden;\n  box-sizing: border-box;\n}\n\n/* 1. Top Navbar */\n.showroom-nav {\n  min-height: 62px;\n  height: auto;\n  padding: 8px 24px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n  background: rgba(10, 13, 18, 0.92);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  z-index: 50;\n  box-sizing: border-box;\n  width: 100%;\n}\n\n.nav-brand {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-shrink: 0;\n  min-width: 0;\n}\n\n.brand-badge {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.15em;\n  padding: 3px 8px;\n  background: #2563eb;\n  color: #ffffff;\n  border-radius: 4px;\n  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.4);\n  flex-shrink: 0;\n}\n\n.brand-series {\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  color: #e2e8f0;\n  white-space: nowrap;\n}\n\n.brand-sub {\n  font-size: 12px;\n  color: #64748b;\n  padding-left: 8px;\n  border-left: 1px solid rgba(255, 255, 255, 0.12);\n  white-space: nowrap;\n}\n\n.nav-status {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n/* Clickable Status Pills in Navbar */\n.nav-device-pill {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 10px;\n  border-radius: 999px;\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  background: rgba(255, 255, 255, 0.04);\n  color: #94a3b8;\n  font-size: 11px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.nav-device-pill:hover {\n  background: rgba(255, 255, 255, 0.08);\n  color: #ffffff;\n  border-color: rgba(255, 255, 255, 0.2);\n}\n\n.nav-device-pill .pill-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background-color: #64748b;\n  transition: all 0.2s ease;\n}\n\n.nav-device-pill.pill-on {\n  border-color: rgba(59, 130, 246, 0.35);\n  background: rgba(37, 99, 235, 0.15);\n  color: #bfdbfe;\n}\n\n.nav-device-pill.pill-on .pill-dot {\n  background-color: #3b82f6;\n  box-shadow: 0 0 8px #60a5fa;\n}\n\n.nav-device-pill.pill-on.pill-spot {\n  border-color: rgba(234, 179, 8, 0.45);\n  background: rgba(234, 179, 8, 0.16);\n  color: #fef08a;\n}\n\n.nav-device-pill.pill-on.pill-spot .pill-dot {\n  background-color: #eab308;\n  box-shadow: 0 0 8px #facc15;\n}\n\n.nav-device-pill.pill-on.pill-morning {\n  border-color: rgba(249, 115, 22, 0.45);\n  background: rgba(249, 115, 22, 0.16);\n  color: #fed7aa;\n}\n\n.nav-device-pill.pill-on.pill-morning .pill-dot {\n  background-color: #f97316;\n  box-shadow: 0 0 8px #fb923c;\n}\n\n.nav-device-pill.pill-on.pill-night {\n  border-color: rgba(99, 102, 241, 0.45);\n  background: rgba(99, 102, 241, 0.16);\n  color: #c7d2fe;\n}\n\n.nav-device-pill.pill-on.pill-night .pill-dot {\n  background-color: #6366f1;\n  box-shadow: 0 0 8px #818cf8;\n}\n\n.status-text {\n  font-size: 11.5px;\n  color: #94a3b8;\n  padding: 0 4px;\n}\n\n.temp-badge {\n  font-size: 11px;\n  font-weight: 500;\n  padding: 4px 10px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.06);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  color: #f8fafc;\n}\n\n/* 2. Main Showroom Stage Composition */\n.showroom-main-stage {\n  flex: 1;\n  display: flex;\n  gap: 24px;\n  padding: 18px 24px 22px;\n  box-sizing: border-box;\n  min-height: calc(100vh - 62px);\n  align-items: stretch;\n  max-width: 1920px;\n  margin: 0 auto;\n  width: 100%;\n}\n\n/* Left Pane: 100% Code-Generated Architectural Living Room */\n.showroom-room-pane {\n  flex: 1 1 64%;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  position: relative;\n  min-height: 520px;\n}\n\n.room-viewport-frame {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  min-height: 520px;\n  border-radius: clamp(14px, 2.5vw, 24px);\n  overflow: hidden;\n  box-shadow: \n    0 30px 80px rgba(0, 0, 0, 0.85),\n    0 0 0 1px rgba(255, 255, 255, 0.08);\n  background-color: #060912;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* Top Room Banner Overlay */\n.room-header-overlay {\n  position: absolute;\n  top: 16px;\n  left: 20px;\n  right: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  z-index: 30;\n  pointer-events: none;\n}\n\n.room-title-tag {\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.04em;\n  color: #e2e8f0;\n  background: rgba(10, 15, 25, 0.78);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  padding: 5px 12px;\n  border-radius: 999px;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);\n}\n\n.room-icon {\n  color: #38bdf8;\n}\n\n.room-scene-badge {\n  font-size: 11px;\n  font-weight: 600;\n  color: #38bdf8;\n  background: rgba(10, 15, 25, 0.78);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  padding: 5px 14px;\n  border-radius: 999px;\n  border: 1px solid rgba(56, 189, 248, 0.35);\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);\n}\n\n/* Bottom Overlay inside 3D Room */\n.room-footer-overlay {\n  position: absolute;\n  bottom: 18px;\n  left: 20px;\n  right: 20px;\n  z-index: 30;\n  pointer-events: auto;\n}\n\n.active-chips-list {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.fixture-chip {\n  font-size: 11px;\n  padding: 5px 12px;\n  border-radius: 8px;\n  background: rgba(15, 20, 28, 0.85);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  color: #94a3b8;\n  backdrop-filter: blur(10px);\n  transition: all 0.25s ease;\n  user-select: none;\n}\n\n.fixture-chip.chip-active {\n  background: rgba(37, 99, 235, 0.25);\n  border-color: rgba(59, 130, 246, 0.5);\n  color: #93c5fd;\n  box-shadow: 0 0 10px rgba(59, 130, 246, 0.2);\n}\n\n.fixture-chip.chip-device-fan {\n  background: rgba(37, 99, 235, 0.28);\n  border-color: #3b82f6;\n  color: #bfdbfe;\n  cursor: pointer;\n  box-shadow: 0 0 12px rgba(37, 99, 235, 0.3);\n}\n\n.fixture-chip.chip-device-ac {\n  background: rgba(14, 165, 233, 0.25);\n  border-color: #38bdf8;\n  color: #bae6fd;\n  cursor: pointer;\n  box-shadow: 0 0 12px rgba(14, 165, 233, 0.3);\n}\n\n.fixture-chip.chip-device-curtain {\n  background: rgba(129, 140, 248, 0.25);\n  border-color: #818cf8;\n  color: #e0e7ff;\n  cursor: pointer;\n}\n\n.fixture-chip[role=\"button\"]:hover {\n  filter: brightness(1.2);\n  transform: translateY(-1px);\n}\n\n/* Right Pane: Custom Smart Keypad Wall Station */\n.showroom-control-pane {\n  flex: 0 0 390px;\n  max-width: 420px;\n  display: flex;\n  flex-direction: column;\n}\n\n.controller-wall-panel {\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(180deg, #13171e 0%, #0a0c10 100%);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: clamp(16px, 2.5vw, 24px);\n  padding: clamp(14px, 2.5vw, 20px) clamp(10px, 2vw, 18px);\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  align-items: center;\n  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);\n  position: relative;\n}\n\n.panel-header {\n  text-align: center;\n  position: relative;\n  z-index: 5;\n  margin-bottom: 6px;\n}\n\n.panel-kicker {\n  font-size: 10px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.2em;\n  color: #38bdf8;\n  display: block;\n  margin-bottom: 3px;\n}\n\n.panel-title {\n  font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;\n  font-size: 18px;\n  font-weight: 600;\n  color: #f8fafc;\n  margin: 0 0 4px 0;\n}\n\n.panel-desc {\n  font-size: 11px;\n  color: #64748b;\n  margin: 0;\n  line-height: 1.4;\n}\n\n.panel-desc strong {\n  color: #94a3b8;\n}\n\n/* Keypad Type Selection Segmented Bar */\n.keypad-type-bar {\n  display: flex;\n  width: 100%;\n  gap: 8px;\n  background: rgba(10, 13, 18, 0.75);\n  padding: 4px;\n  border-radius: 12px;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  margin: 0 0 14px;\n  box-sizing: border-box;\n}\n\n.keypad-type-btn {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 12px;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: #94a3b8;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  text-align: left;\n}\n\n.keypad-type-btn:hover {\n  background: rgba(255, 255, 255, 0.04);\n  color: #e2e8f0;\n}\n\n.keypad-type-btn.is-active {\n  background: rgba(56, 189, 248, 0.12);\n  border-color: rgba(56, 189, 248, 0.35);\n  color: #ffffff;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);\n}\n\n/* Selector Icons */\n.type-icon-grid {\n  width: 22px;\n  height: 22px;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  grid-template-rows: repeat(4, 1fr);\n  gap: 2px;\n  padding: 2.5px;\n  border-radius: 3px;\n  background: #191c24;\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  box-sizing: border-box;\n  flex-shrink: 0;\n}\n\n.type-icon-grid span {\n  background: #64748b;\n  border-radius: 1px;\n}\n\n.keypad-type-btn.is-active .type-icon-grid span {\n  background: #38bdf8;\n}\n\n.type-icon-dual {\n  width: 22px;\n  height: 22px;\n  display: flex;\n  flex-direction: column;\n  padding: 2.5px;\n  border-radius: 3px;\n  background: #191c24;\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  box-sizing: border-box;\n  flex-shrink: 0;\n}\n\n.dual-bar-top,\n.dual-bar-bottom {\n  flex: 1;\n  background: #64748b;\n  border-radius: 1px;\n}\n\n.dual-divider-line {\n  height: 2px;\n  background: #090a0d;\n}\n\n.keypad-type-btn.is-active .dual-bar-top,\n.keypad-type-btn.is-active .dual-bar-bottom {\n  background: #38bdf8;\n}\n\n.type-btn-text {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  overflow: hidden;\n}\n\n.type-btn-title {\n  font-size: 11.5px;\n  font-weight: 600;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.type-btn-ref {\n  font-size: 9px;\n  color: #64748b;\n  font-weight: 500;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.keypad-type-btn.is-active .type-btn-ref {\n  color: #7dd3fc;\n}\n\n.keypad-mount-area {\n  margin: 4px 0 10px;\n  width: 100%;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  position: relative;\n  z-index: 5;\n}\n\n.keypad-unified-station {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  position: relative;\n  width: 100%;\n  max-width: 320px;\n}\n\n/* Action HUD at Base of Controller Panel */\n.panel-hud {\n  width: 100%;\n  background: rgba(7, 9, 13, 0.88);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 12px;\n  padding: 10px 14px;\n  box-sizing: border-box;\n  position: relative;\n  z-index: 5;\n}\n\n.hud-action-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.hud-action-tag {\n  font-size: 9.5px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  padding: 2.5px 8px;\n  border-radius: 4px;\n  white-space: nowrap;\n}\n\n.tag-ready {\n  background: rgba(100, 116, 139, 0.25);\n  color: #94a3b8;\n}\n\n.tag-fan {\n  background: rgba(37, 99, 235, 0.3);\n  color: #93c5fd;\n  border: 1px solid rgba(59, 130, 246, 0.5);\n}\n\n.tag-ac {\n  background: rgba(14, 165, 233, 0.3);\n  color: #7dd3fc;\n  border: 1px solid rgba(56, 189, 248, 0.5);\n}\n\n.tag-curtain {\n  background: rgba(129, 140, 248, 0.3);\n  color: #c7d2fe;\n  border: 1px solid rgba(129, 140, 248, 0.5);\n}\n\n.tag-dimmer {\n  background: rgba(245, 158, 11, 0.3);\n  color: #fde68a;\n  border: 1px solid rgba(245, 158, 11, 0.5);\n}\n\n.tag-spotlights {\n  background: rgba(234, 179, 8, 0.25);\n  color: #fef08a;\n  border: 1px solid rgba(234, 179, 8, 0.45);\n}\n\n.tag-morning {\n  background: rgba(249, 115, 22, 0.25);\n  color: #ffedd5;\n  border: 1px solid rgba(249, 115, 22, 0.5);\n}\n\n.tag-night {\n  background: rgba(99, 102, 241, 0.25);\n  color: #e0e7ff;\n  border: 1px solid rgba(99, 102, 241, 0.5);\n}\n\n.tag-scene {\n  background: rgba(168, 85, 247, 0.25);\n  color: #e9d5ff;\n  border: 1px solid rgba(168, 85, 247, 0.5);\n}\n\n.tag-fixture {\n  background: rgba(56, 189, 248, 0.25);\n  color: #bae6fd;\n  border: 1px solid rgba(56, 189, 248, 0.4);\n}\n\n.hud-action-label {\n  color: #cbd5e1;\n  font-size: 11.5px;\n  line-height: 1.35;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.hud-action-label strong {\n  color: #f1f5f9;\n}\n\n/* 3. Comprehensive Responsive Breakpoints */\n\n/* Large Desktops & Ultrawide Monitors (>= 1440px) */\n@media (min-width: 1440px) {\n  .showroom-main-stage {\n    padding: 24px 36px 30px;\n    gap: 32px;\n  }\n  .showroom-control-pane {\n    flex: 0 0 420px;\n    max-width: 440px;\n  }\n}\n\n/* Tablet Landscape & Small Laptops (861px - 1180px in landscape) */\n@media (min-width: 861px) and (max-width: 1180px) and (orientation: landscape) {\n  .showroom-main-stage {\n    flex-direction: row;\n    padding: 12px 18px;\n    gap: 16px;\n  }\n  .showroom-room-pane {\n    flex: 1 1 0;\n    min-width: 0;\n    min-height: calc(100vh - 90px);\n  }\n  .room-viewport-frame {\n    min-height: calc(100vh - 90px);\n  }\n  .showroom-control-pane {\n    flex: 0 0 350px;\n    max-width: 360px;\n  }\n  .brand-sub {\n    display: none;\n  }\n}\n\n/* Tablet Portrait & Medium Screens (<= 1080px in portrait, or <= 860px) */\n@media (max-width: 1080px) and (orientation: portrait), (max-width: 860px) {\n  .showroom-nav {\n    height: auto;\n    padding: 8px 16px;\n    flex-wrap: wrap;\n 